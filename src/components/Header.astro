---
import { menuUtama, situs } from '@/lib/site';
const path = Astro.url.pathname;
---

<header
  class="sticky top-0 z-40 bg-pearl/85 backdrop-blur-md border-b border-nacre"
  x-data="{ terbuka: false }"
  @keydown.escape.window="terbuka = false"
>
  <div class="wadah flex items-center justify-between h-18 py-3">
    <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label={`Beranda ${situs.nama}`}>
      <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
        <circle cx="13" cy="13" r="11" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".35" />
        <circle cx="13" cy="13" r="6.5" fill="var(--color-emas)" />
        <circle cx="10.6" cy="10.6" r="1.7" fill="#fff" opacity=".8" />
      </svg>
      <span class="font-display font-semibold text-[1.05rem] tracking-tight">
        Mutiara<span class="text-kilau">Soft</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-7" aria-label="Navigasi utama">
      {menuUtama.map((item) => (
        <a
          href={item.href}
          aria-current={path.startsWith(item.href) ? 'page' : undefined}
          class:list={[
            'text-[0.95rem] transition-colors hover:text-kilau',
            path.startsWith(item.href) ? 'text-kilau font-semibold' : 'text-ink/75',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a href="/pesan" class="tombol-utama text-[0.95rem] py-2.5 px-5">Mulai proyek</a>
    </nav>

    <button
      type="button"
      class="md:hidden p-2 -mr-2"
      @click="terbuka = !terbuka"
      :aria-expanded="terbuka"
      aria-controls="menu-seluler"
      aria-label="Buka menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <template x-if="!terbuka"><g><path d="M4 7h16M4 12h16M4 17h16" /></g></template>
        <template x-if="terbuka"><g><path d="M6 6l12 12M18 6L6 18" /></g></template>
      </svg>
    </button>
  </div>

  <div
    id="menu-seluler"
    class="md:hidden border-t border-nacre bg-pearl"
    x-show="terbuka"
    x-transition.origin.top
    x-cloak
  >
    <nav class="wadah py-4 flex flex-col gap-1" aria-label="Navigasi seluler">
      {menuUtama.map((item) => (
        <a href={item.href} class="py-2.5 border-b border-nacre/60 text-ink/80">{item.label}</a>
      ))}
      <a href="/pesan" class="tombol-utama justify-center mt-4">Mulai proyek</a>
    </nav>
  </div>
</header>

<style is:global>
  [x-cloak] { display: none !important; }
</style>
