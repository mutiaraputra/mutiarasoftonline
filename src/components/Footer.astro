---
import { menuUtama, situs, tautanWhatsApp } from '@/lib/site';
const tahun = new Date().getFullYear();
---

<footer class="bg-ink text-pearl/80 mt-24">
  <div class="wadah py-16 grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-display text-sedang text-pearl">{situs.nama}</p>
      <p class="mt-3 text-[0.95rem] max-w-sm">
        Sejak {situs.berdiri} membangun perangkat lunak untuk usaha di Indonesia — dari
        aplikasi kasir sampai sistem informasi internal.
      </p>
      <address class="mt-4 text-mikro text-pearl/55 not-italic leading-relaxed">
        {situs.alamat.jalan}<br />
        {situs.alamat.desa}, {situs.alamat.kabupaten}<br />
        {situs.alamat.provinsi} {situs.alamat.kodePos}
      </address>
    </div>

    <nav aria-label="Navigasi footer">
      <p class="font-semibold text-pearl mb-3">Jelajahi</p>
      <ul class="space-y-2 text-[0.95rem]">
        {menuUtama.map((item) => (
          <li><a href={item.href} class="hover:text-emas transition-colors">{item.label}</a></li>
        ))}
        <li><a href="/pesan" class="hover:text-emas transition-colors">Pesan aplikasi</a></li>
        <li><a href="/sitemap" class="hover:text-emas transition-colors">Peta Situs</a></li>
      </ul>
    </nav>

    <div>
      <p class="font-semibold text-pearl mb-3">Hubungi</p>
      <ul class="space-y-2 text-[0.95rem]">
        <li>
          <a href={tautanWhatsApp('Halo Mutiara Software, saya ingin berdiskusi soal aplikasi.')} class="hover:text-emas transition-colors">
            WhatsApp +{situs.whatsapp}
          </a>
        </li>
        <li><a href={`mailto:${situs.email}`} class="hover:text-emas transition-colors">{situs.email}</a></li>
        <li><a href={situs.facebook} class="hover:text-emas transition-colors" rel="me">Facebook</a></li>
        <li><a href={situs.youtube} class="hover:text-emas transition-colors" rel="me">YouTube</a></li>
        <li><a href={situs.indukUrl} class="hover:text-emas transition-colors">Mutiara Komputer</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-pearl/10">
    <div class="wadah py-5 flex flex-col sm:flex-row justify-between items-center gap-3 text-mikro text-pearl/50">
      <p>
        © {tahun} {situs.nama}. Seluruh hak cipta dilindungi.
      </p>
      <div class="flex items-center gap-4">
        <a href="/sitemap" class="hover:text-emas transition-colors">Peta Situs</a>
        <span aria-hidden="true">•</span>
        <a href="/sitemap-index.xml" target="_blank" rel="noopener" class="hover:text-emas transition-colors">Sitemap XML</a>
      </div>
    </div>
  </div>
</footer>
