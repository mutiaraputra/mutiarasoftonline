---
interface Props {
  slug: string;
  nama: string;
  ringkas: string;
  platform: readonly string[];
  fitur: readonly string[];
  unggulan?: boolean;
}
const { slug, nama, ringkas, platform, fitur, unggulan = false } = Astro.props;

const ikonPlatform: Record<string, string> = {
  desktop: 'Desktop',
  web: 'Web',
  mobile: 'Android',
};
---

<article
  class:list={[
    'group relative flex flex-col bg-pearl-2 border rounded-[var(--radius-kartu)] p-6 transition-colors',
    unggulan ? 'border-emas' : 'border-nacre hover:border-kilau/50',
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-display font-semibold text-sedang">
      <a href={`/produk/${slug}`} class="after:absolute after:inset-0">{nama}</a>
    </h3>
    {unggulan && (
      <span class="shrink-0 text-mikro font-semibold text-ink bg-emas-lembut px-2.5 py-1 rounded-full">
        Andalan
      </span>
    )}
  </div>

  <p class="mt-3 text-[0.95rem] text-ink/70 flex-1">{ringkas}</p>

  <ul class="mt-4 space-y-1.5 text-[0.9rem] text-ink/75">
    {fitur.slice(0, 3).map((f) => (
      <li class="flex gap-2.5">
        <span class="mt-2 size-1.5 rounded-full bg-kilau shrink-0" aria-hidden="true"></span>
        <span>{f}</span>
      </li>
    ))}
  </ul>

  <p class="mt-5 pt-4 border-t border-nacre text-mikro text-ink/55">
    {platform.map((p) => ikonPlatform[p] ?? p).join(' · ')}
  </p>
</article>
