# ---------------------------------------------------------------------------
# Situs
# ---------------------------------------------------------------------------
PUBLIC_SITE_URL="https://mutiarasoft.online"
PUBLIC_WHATSAPP="6285755080250"

# ---------------------------------------------------------------------------
# Notifikasi Telegram
# Buat bot lewat @BotFather, lalu ambil chat id lewat @userinfobot
# atau https://api.telegram.org/bot<TOKEN>/getUpdates
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TELEGRAM_CHAT_ID="-1001234567890"
# Opsional: kirim ke beberapa tujuan sekaligus, pisahkan dengan koma
# TELEGRAM_CHAT_ID="-1001234567890,987654321"

# ---------------------------------------------------------------------------
# Penyimpanan pesanan
# "bridge" = lewat endpoint PHP di cPanel (default, paling aman untuk shared hosting)
# "mysql"  = koneksi langsung ke MySQL (butuh remote MySQL + whitelist IP)
# "none"   = hanya kirim Telegram, tanpa simpan (untuk uji coba awal)
# ---------------------------------------------------------------------------
ORDER_STORAGE="bridge"

# --- Mode "bridge" ---
ORDER_BRIDGE_URL="https://mutiarakom.my.id/api/order-bridge.php"
ORDER_BRIDGE_SECRET="ganti-dengan-string-acak-minimal-48-karakter"

# --- Mode "mysql" ---
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="uvvikcvj_mutiarasoft"
DB_USER="uvvikcvj_web"
DB_PASSWORD=""

# ---------------------------------------------------------------------------
# Anti-spam
# ---------------------------------------------------------------------------
ORDER_RATE_LIMIT_PER_HOUR="5"
